# Пример конфигурации model-gateway-v2
# Скопируйте в .env и заполните свои значения.
# В systemd-варианте эти переменные прописываются в Environment= строках service-файла.

# ── Сеть ─────────────────────────────────────────────────────────────
MODEL_GATEWAY_HOST=0.0.0.0
MODEL_GATEWAY_PORT=8080

# ── Аутентификация ────────────────────────────────────────────────────
# Вариант 1: одиночный токен
MODEL_GATEWAY_TOKEN=your_secret_token_here

# Вариант 2: несколько токенов с лейблами (имеет приоритет над MODEL_GATEWAY_TOKEN)
# Формат: token1|label1,token2|label2
MODEL_GATEWAY_TOKENS=token_for_admin|admin,token_for_client|client

# ── Бэкенды (JSON-объект: "model-id" → "host:port") ───────────────────
VLLM_BACKENDS={"my-model":"127.0.0.1:8000","vision-model":"127.0.0.1:8001"}

# Fallback-бэкенд при неизвестной модели (по умолчанию — первый из VLLM_BACKENDS)
VLLM_PRIMARY=127.0.0.1:8000

# ── Переименование моделей ────────────────────────────────────────────
# Внешний alias → внутренний ID, который ожидает vLLM-бэкенд
# MODEL_REWRITES={"public-alias":"Internal-Model-File.gguf"}
MODEL_REWRITES=

# ── Thinking-модели ───────────────────────────────────────────────────
# Comma-separated список моделей, поддерживающих thinking-режим
THINKING_MODELS=my-model

# Управление thinking:
#   -1 = не управлять (модель использует дефолт)
#    0 = отключить thinking (enable_thinking=false)
#   >0 = задать бюджет токенов (thinking_budget=N)
THINKING_BUDGET=0

# ── Image backend (опционально) ───────────────────────────────────────
IMAGE_BACKEND_URL=http://127.0.0.1:8091
IMAGE_BACKEND_TOKEN=your_image_backend_token_here
